<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Domain\AiFramework.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <!-- The instant-answer catalog (ADR 0036). LogicalName gives a stable "quick/en/..." name; the
       loader normalises the separator, which is "\" on Windows. -->
  <ItemGroup>
    <EmbeddedResource Include="Assistant\Quick\Catalog\**\*.json;Assistant\Quick\Catalog\**\*.md"
                      LogicalName="quick/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
