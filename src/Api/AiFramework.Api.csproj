<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>ac9fbbb7-d110-4c66-a077-d8399f9a1103</UserSecretsId>
    <!-- The document is committed at the repo root so frontend generation reads a file rather
         than a running API, and so a contract change shows up as a diff in review.

         OnBuild is deliberately FALSE. Generation runs the whole application, which needs a
         connection string to clear the startup guard in Program.cs and Wolverine__Durable=false
         to stop Wolverine dialling Postgres (ADR 0005). With OnBuild true, every `dotnet build`
         of this project needed both - a plain build failed even with the database running, and
         the existing CI backend and e2e jobs would have started failing. Generation is therefore
         an explicit target, run by the two commands in the root CLAUDE.md and by CI's contract
         job:

           dotnet msbuild src/Api -t:"Build;GenerateOpenApiDocuments" -->
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\AiFramework.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\AiFramework.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
    <!-- AddDbContextCheck, for the /health/ready readiness probe. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <!--
      The SignalR backplane. Not optional above one replica: the outbox pump that writes a
      notification runs on EVERY replica and claims rows with FOR UPDATE SKIP LOCKED, so the pod
      that writes is unrelated to the pod holding that user's connection. Without this, a push
      reaches the user only when those happen to coincide - about half the time at the two
      replicas k8s/base/api.yaml runs - and fails silently the rest. See ADR 0019.
    -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    OpenTelemetry: the export pipeline for every ILogger record and Activity in the solution.
    These five track their own release counter (1.18.0), independent of the shared framework's
    10.0.11 patch line, and are released together — keep them on one version. See
    docs/superpowers/plans/2026-09-13-centralized-logging.md and ADR 0014.
  -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
  </ItemGroup>

</Project>
