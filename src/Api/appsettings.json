{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Cache": {
    "Enabled": true,
    "MaximumDuration": "00:01:00"
  },
  "Resilience": {
    "Enabled": true,
    "TotalRequestTimeout": "00:00:30",
    "AttemptTimeout": "00:00:10",
    "MaxRetryAttempts": 3,
    "BaseDelay": "00:00:02",
    "ExchangeRateBaseAddress": "https://api.frankfurter.dev/v1"
  }
}
