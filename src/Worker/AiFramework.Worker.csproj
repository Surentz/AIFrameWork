<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Microsoft.NET.Sdk.Web, not Sdk.Worker, and that is deliberate rather than convenient.

    Kubernetes has no way to probe a process that serves no HTTP: an exec probe needs a shell,
    and the chiseled base image has none — the same fact k8s/base/api.yaml records when explaining
    why its preStop uses the native sleep hook rather than an exec command. This host therefore
    serves exactly two endpoints, /health and /health/ready, and maps no controllers.

    Two things fall out of that and are worth having on purpose: AddObservability works unchanged
    (it is a WebApplicationBuilder extension), and RunJasperFxCommands applies identically, which
    is what makes this project's own `codegen write` reachable. See ADR 0016.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Application\AiFramework.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\AiFramework.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AddDbContextCheck, for the /health/ready readiness probe. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

  <!--
    OpenTelemetry, matching src/Api/AiFramework.Api.csproj's set minus ASP.NET instrumentation:
    this host's only HTTP surface is two probe endpoints, and a span or a request metric per
    kubelet probe every ten seconds is noise, not telemetry. Runtime metrics come from the
    built-in "System.Runtime" meter via AddMeter, as in the API (ADR 0027), so no runtime package.

    These track their own release counter (1.19.x), independent of the shared framework's 10.0.x
    patch line, and are released together — keep them on one version. See ADRs 0015 and 0027.
  -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
  </ItemGroup>

  <!--
    Debug only, exactly as AiFramework.Infrastructure.csproj does it and for the same reason:
    Wolverine generates handler adapters with Roslyn, and as of 6.0 core WolverineFx no longer
    carries the compiler. Release runs TypeLoadMode.Static against the code committed under
    Internal/Generated, and the compiler costs 33MB in a published image (measured: 17MB without,
    50MB with). A PrivateAssets attribute does not save us here — the conditional reference is the
    only guard. Regenerate with:

      dotnet run (project src/Worker) with the JasperFx "codegen write" command

    This is a SECOND generated tree, separate from the Api's. Release resolves pre-built types out
    of opts.ApplicationAssembly, and this host's is its own; it cannot share the Api's, because
    that would need a Worker -> Api reference the dependency rule forbids. WorkerCodegenTests
    fails in the Debug suite if this tree goes stale. ADR 0005, ADR 0016.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.46.0" />
  </ItemGroup>

</Project>
