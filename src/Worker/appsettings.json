{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Cache": {
    "Enabled": false,
    "MaximumDuration": "00:01:00"
  },
  "Jobs": {
    "Queues": "light,heavy",
    "LightParallelism": 8,
    "HeavyParallelism": 2
  },
  "Observability": {
    "ServiceName": "aiframework-worker",
    "Otlp": {
      "Enabled": false,
      "Endpoint": "http://localhost:4318",
      "Traces": true
    }
  },
  "Resilience": {
    "Enabled": true,
    "TotalRequestTimeout": "00:00:30",
    "AttemptTimeout": "00:00:10",
    "MaxRetryAttempts": 3,
    "BaseDelay": "00:00:02",
    "ExchangeRateBaseAddress": "https://api.frankfurter.dev/v1"
  }
}
