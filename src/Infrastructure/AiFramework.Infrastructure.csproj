<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Application\AiFramework.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Explicit and public (no PrivateAssets) so the version request flows through the
      ProjectReference into Api. Without it, Api's own restore graph only sees
      Npgsql.EntityFrameworkCore.PostgreSQL's floor requirement ([10.0.4, 11.0.0)) for this
      package - because Microsoft.EntityFrameworkCore.Design's matching higher requirement is
      PrivateAssets="all" and does not flow - so NuGet resolves Relational to 10.0.4 for Api
      while Infrastructure.dll is compiled against 10.0.11, producing an MSB3277 conflict at
      Api's build. Pinning it here unifies both projects on 10.0.11.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <!--
      HybridCache, for the query-caching behavior in Messaging/Behaviors.cs. Chosen over a bare
      IMemoryCache for three things that would otherwise be hand-rolled: stampede protection (ten
      concurrent misses collapse to one load), RemoveByTagAsync for per-caller invalidation, and an
      L2 tier that can be added later without touching a call site. L1 only today. See ADR 0009.
    -->
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <!--
      For PasswordHasher<T> alone (Security/PasswordHasher.cs). This is the plain hashing
      primitive - PBKDF2, versioned format, constant-time compare - not the ASP.NET Core Identity
      stack: no UserManager, no EF stores, no eight tables. The User aggregate stays hand-rolled
      in Domain, which is what keeps EF Core and DataAnnotations out of that layer (ADR 0006).
    -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.11" />
    <!-- BackgroundService/IHostedService for the outbox pumps (OutboxHostedServices.cs). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <!-- IOptions binding for CacheOptions (Caching/CachingRegistration.cs). Explicit rather
         than transitive, for the same reason Relational is pinned above. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="WolverineFx" Version="6.33.0" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.33.0" />
    <PackageReference Include="WolverineFx.Postgresql" Version="6.33.0" />
  </ItemGroup>

  <!--
    Debug only, and deliberately so (ADR 0005). Wolverine generates its handler adapters with
    Roslyn; as of 6.0 core WolverineFx no longer carries the compiler, so it is referenced here
    for development and left out of Release entirely. This repo has already paid the
    Roslyn-in-the-publish-output tax once - Microsoft.EntityFrameworkCore.Design in Api.csproj
    took the publish from 7.9MB to 37MB - and PrivateAssets does not prevent it, because it
    stops assets flowing to CONSUMERS of a project, not into the declaring project's own output.
    A Condition is the only thing that actually keeps it out.

    The consequence: a Release build has no runtime compiler, so Release loads adapters generated
    ahead of time by the Wolverine "codegen write" command and committed under
    src/Api/Internal/Generated, with TypeLoadMode.Static. Measured for this package specifically:
    a Release publish is 17MB without it and 50MB with it. See the "Wolverine codegen" section of
    the root CLAUDE.md and ADR 0005. WolverineCodegenTests fails in the Debug suite if the
    generated code stops matching its handlers, which neither the compiler nor a Debug run can see.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.33.0" />
  </ItemGroup>

</Project>
