<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Application\AiFramework.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Explicit and public (no PrivateAssets) so the version request flows through the
      ProjectReference into Api. Without it, Api's own restore graph only sees
      Npgsql.EntityFrameworkCore.PostgreSQL's floor requirement ([10.0.4, 11.0.0)) for this
      package - because Microsoft.EntityFrameworkCore.Design's matching higher requirement is
      PrivateAssets="all" and does not flow - so NuGet resolves Relational to 10.0.4 for Api
      while Infrastructure.dll is compiled against 10.0.11, producing an MSB3277 conflict at
      Api's build. Pinning it here unifies both projects on 10.0.11.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <!-- BackgroundService/IHostedService for the outbox pumps (OutboxHostedServices.cs). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="WolverineFx" Version="6.33.0" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.33.0" />
    <PackageReference Include="WolverineFx.Postgresql" Version="6.33.0" />
  </ItemGroup>

  <!--
    Debug only, and deliberately so (ADR 0005). Wolverine generates its handler adapters with
    Roslyn; as of 6.0 core WolverineFx no longer carries the compiler, so it is referenced here
    for development and left out of Release entirely. This repo has already paid the
    Roslyn-in-the-publish-output tax once - Microsoft.EntityFrameworkCore.Design in Api.csproj
    took the publish from 7.9MB to 37MB - and PrivateAssets does not prevent it, because it
    stops assets flowing to CONSUMERS of a project, not into the declaring project's own output.
    A Condition is the only thing that actually keeps it out.

    The consequence: a Release build has no runtime compiler, so Release requires code generated
    ahead of time by the Wolverine "codegen write" command and TypeLoadMode.Static. That build
    step does not exist yet - while this is a spike, Debug is the only configuration that runs.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.33.0" />
  </ItemGroup>

</Project>
