{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "generate:api": "node ../scripts/normalize-openapi.mjs && npx --yes openapi-typescript@7.13.0 ../openapi/AiFramework.Api.json --immutable --output src/api/schema.d.ts",
    "e2e": "node e2e/setup/run.ts",
    "e2e:ui": "node e2e/setup/run.ts --ui",
    "e2e:kind": "node e2e/setup/run.ts --target kind",
    "e2e:url": "node e2e/setup/run.ts --target",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@tanstack/react-query": "^5.106.1",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "msw": "^3.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
