root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:error
dotnet_style_require_accessibility_modifiers = always:error
csharp_style_prefer_null_check_over_type_check = true:error

# --- Exception discipline (spec 6.4) ---
dotnet_diagnostic.CA1031.severity = error   # do not catch general exception types
dotnet_diagnostic.CA2200.severity = error   # rethrow to preserve stack details

# --- Argument and null validation (spec 6.2) ---
dotnet_diagnostic.CA1062.severity = error   # validate arguments of public methods

# --- Disposal ---
dotnet_diagnostic.CA2000.severity = error
dotnet_diagnostic.CA1063.severity = error

# --- Deliberately off: no synchronization context in ASP.NET Core, so
# ConfigureAwait(false) is noise. Covers both CA2007 (Roslyn) and MA0004
# (Meziantou.Analyzer), which enforce the same rule. ---
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none

# --- Deliberately off: cohesive types share a file (a command with its handler and
#     validator), which is this repo's chosen structure. See the request-path plan. ---
dotnet_diagnostic.MA0048.severity = none

# --- Deliberately off: C#-only codebase, so cross-language keyword collisions
#     (CA1716) are not a risk worth renaming public types for. ---
dotnet_diagnostic.CA1716.severity = none

[*.{ts,js,mjs,cjs}]
indent_size = 2
quote_type = single

[*.{html,scss,css,json,yml,yaml}]
indent_size = 2

[*.{xml,csproj,props,targets}]
indent_size = 2

[*.ps1]
indent_size = 4
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

# --- EF Core migrations: scaffolded by `dotnet ef migrations add`, not hand-written, and the
# protect-migrations hook blocks editing them once created (see CLAUDE.md, "Never hand-edit an
# applied EF migration"). The *.Designer.cs and *ModelSnapshot.cs files carry an
# `// <auto-generated />` header that most analyzers already skip; the primary migration file
# (Up/Down) does not get that header from the EF template, so it is otherwise checked as
# hand-written code against rules its own generator does not satisfy: CA1062 (EF's template
# never null-checks the MigrationBuilder parameter), IDE0161 (EF's template emits a
# block-scoped namespace), and CA1861 (CreateIndex's generated `columns: new[] { ... }` call
# is a literal array argument the template always emits inline, for a method that runs once
# at migration time, not in a hot path). Scoped to this generated folder only - not a
# repo-wide exemption. ---
[src/Infrastructure/Persistence/Migrations/*.cs]
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CA1861.severity = none
