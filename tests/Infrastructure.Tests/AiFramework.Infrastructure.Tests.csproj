<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- The test's Refit interface is source-generated in this assembly. -->
    <PackageReference Include="Refit.HttpClientFactory" Version="16.3.0" />
    <PackageReference Include="Testcontainers.Keycloak" Version="4.16.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Infrastructure\AiFramework.Infrastructure.csproj" />
    <ProjectReference Include="..\PartnerSimulator\AiFramework.PartnerSimulator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assistant\Quick\evaluation.en.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The assistant's embedding model, for the embedder tests and the evaluation gate (ADR 0036).
       Fetched by scripts/fetch-assistant-model.ps1 into the git-ignored models/assistant, copied
       beside the binaries as assistant-model/. Conditional, so a build without it still succeeds. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\models\assistant\model.onnx')">
    <None Include="$(MSBuildThisFileDirectory)..\..\models\assistant\*" LinkBase="assistant-model" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
