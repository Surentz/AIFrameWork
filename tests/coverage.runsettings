<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage for the backend, as CI's backend (Debug) leg measures it and as the PR report
  shows it. Run the same thing locally with:

    dotnet test -settings tests/coverage.runsettings -collect "XPlat Code Coverage" -results-directory TestResults
    dotnet reportgenerator -reports:"TestResults/**/coverage.cobertura.xml" -targetdir:TestResults/coverage

  (double the leading dashes; XML comments cannot hold two in a row).

  Generated code is excluded so the number describes code someone wrote: the Wolverine adapters
  under Internal/Generated (regenerated by `codegen write`, and only ever exercised in Release) and
  the EF migrations (scaffolded by `dotnet ef`, append-only). Each test project instruments the
  production assemblies it loads, and ReportGenerator merges their Cobertura files, so a line
  counts as covered if any project - unit or integration - ran it.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[AiFramework.*]*</Include>
          <Exclude>[AiFramework.*Tests]*</Exclude>
          <ExcludeByFile>**/Internal/Generated/**/*.cs,**/Persistence/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
